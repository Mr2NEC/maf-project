# Copy to .env.dev (docker compose, dev) — see makefile
# MySQL
MYSQL_HOST=mysql
MYSQL_PORT_OUT=3307
MYSQL_PORT_IN=3306
MYSQL_USER=maf
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=maf_project
MYSQL_ROOT_PASSWORD=change-me
MYSQL_SYNCHRONIZE=true

# Backend
BACKEND_PORT=4000
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_SORT_SCHEMA=true
GRAPHQL_PATH=/graphql
GRAPHQL_SCHEMA_PATH=src/schema.gql
GRAPHQL_CORS=true
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=60m

# Optional: URL with clubs JSON for the data initializer
DATA_INIT_CLUBS=

# Dockerfiles
DOCKERFILE_BACKEND=Dockerfile.dev
DOCKERFILE_FRONTEND=Dockerfile.dev
