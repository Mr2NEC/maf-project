# Copy to backend/.env to run the backend locally (without docker).
# Start only the database with: make db-up
NODE_ENV=development
BACKEND_PORT=4000

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=maf
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=maf_project

GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_SORT_SCHEMA=true
GRAPHQL_PATH=/graphql
GRAPHQL_CORS=true

# At least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Session length: a host must not be signed out in the middle of a game night
JWT_EXPIRES_IN=12h
